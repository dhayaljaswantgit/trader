NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
# Execution gates — hardcoded to PAPER in Milestone 1 regardless of these values
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
AUTO_EXECUTION_ENABLED=false
REQUIRE_MANUAL_APPROVAL=true
# Broker: MOCK (no credentials needed) or DHAN (Milestone 2, not yet implemented)
BROKER=MOCK
DHAN_CLIENT_ID=replace_locally
DHAN_ACCESS_TOKEN=replace_locally
DATABASE_URL=postgresql://jassu@localhost:5432/dhan_trader
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# Defaults pre-filled in the "Start Day" form (you set the real values each morning)
PAPER_RISK_PER_TRADE_PCT=0.25
MAX_OPEN_POSITIONS=1
MAX_QUOTE_AGE_MS=5000
MAX_SPREAD_PCT=2
ENTRY_CUTOFF_IST=15:00
SQUARE_OFF_IST=15:15
ENGINE_TICK_MS=5000
PAPER_SLIPPAGE_BPS=3

# --- Delta Exchange India (crypto, market data only — no API key needed) ---
# DELTA_BASE=https://api.india.delta.exchange
# USD → ₹ rate used to express crypto backtests in rupees (approximate)
CRYPTO_USDINR=85
# Default leverage for crypto backtests (margin per contract = notional ÷ leverage)
CRYPTO_LEVERAGE=10

# One-click Dhan login: Redirect URL to enter on web.dhan.co (API key setup). Default works with the Vite dev server.
DHAN_REDIRECT_URL=http://127.0.0.1:5173/api/dhan/oauth/callback

# --- Server deploy (see docs/DEPLOY.md) ---
# Login for every page (HTTP Basic). Leave APP_PASSWORD empty for local use.
# APP_USER=jassu
# APP_PASSWORD=change_me
# Extra allowed browser origins for writes (same host is always allowed), comma-separated
# ALLOWED_ORIGINS=
# DATA_DIR=/app/data
